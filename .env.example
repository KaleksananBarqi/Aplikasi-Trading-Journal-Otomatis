# Template konfigurasi lokal — AMAN untuk di-commit.
#
# PENTING: API key dan secret exchange TIDAK PERNAH ditaruh di sini.
# Kredensial disimpan lewat safeStorage bawaan Electron (DPAPI/Keychain/libsecret),
# lihat keputusan D2 di plans/01-ARCHITECTURE.md.
# Brief §8 dan §11 melarang kredensial di file plaintext dalam bentuk apapun.
#
# File ini hanya untuk konfigurasi development non-sensitif.

# Aktifkan log verbose dari adapter exchange saat development.
TRADING_JOURNAL_DEBUG=1

# ==============================================================================
# PENGUJIAN API KEY ASLI SEBELUM BUILD (`npm run test:real-sync`)
# ==============================================================================
# Salin file ini menjadi `.env` di root proyek (file `.env` ter-ignore oleh git).
# Masukkan API Key read-only Anda di bawah ini untuk menguji koneksi & sync.
#

# --- MEXC Futures ---
MEXC_API_KEY=
MEXC_API_SECRET=

# --- Bitunix Futures ---
BITUNIX_API_KEY=
BITUNIX_API_SECRET=

# --- Opsional ---
# Set ke 1 jika ingin menyimpan kredensial dari .env ke keystore safeStorage OS saat test:
TEST_SAVE_TO_KEYSTORE=0

# Set ke 1 jika ingin hasil sync dari test masuk ke DB produksi aplikasi (data/trading-journal.sqlite), bukan DB temporary:
TEST_USE_REAL_DB=0

# Jika koneksi ke server exchange terblokir oleh ISP / Kominfo (Internet Positif),
# isi URL Proxy Anda di bawah ini (misal: http://127.0.0.1:7890 atau http://127.0.0.1:1080):
# HTTPS_PROXY=http://127.0.0.1:7890

